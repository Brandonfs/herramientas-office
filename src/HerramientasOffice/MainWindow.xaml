<Window x:Class="HerramientasOffice.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Herramientas Office"
        Width="940" Height="480" MinWidth="620" MinHeight="340"
        WindowStartupLocation="CenterScreen"
        Background="#F2F3F5" FontFamily="Segoe UI" FontSize="12" Foreground="#1F2328">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="132" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Menú lateral -->
        <Border Grid.Column="0" Background="#22262B" Padding="10,14,10,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="6,0,0,14">
                    <TextBlock Text="Herramientas" FontSize="14" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock Text="Office" FontSize="14" FontWeight="SemiBold" Foreground="#7C858F" />
                </StackPanel>

                <ListBox x:Name="NavList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{StaticResource NavItem}" SelectionChanged="NavList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2">
                    <Border x:Name="AdminBadge" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Background="#2E3A33">
                        <TextBlock x:Name="AdminBadgeText" Text="Administrador" Foreground="#A9CDB8" FontWeight="SemiBold" FontSize="11" />
                    </Border>
                    <TextBlock x:Name="VersionText" Foreground="#7C858F" FontSize="11" Margin="2,8,0,0" />
                    <TextBlock x:Name="UpdateStatus" Foreground="#7C858F" FontSize="11" Margin="2,0,0,6" TextWrapping="Wrap" />
                    <Button x:Name="BtnCheckApp" Content="Buscar versión" Style="{StaticResource BtnGhost}"
                            Margin="0" Padding="8,4" FontSize="11" Click="BtnCheckApp_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Contenido -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Aviso de nueva versión de la app -->
            <Border x:Name="UpdateBanner" Grid.Row="0" Visibility="Collapsed" Background="#E3E6EA" Padding="14,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="BannerText" Foreground="#2F3640" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <ProgressBar x:Name="BannerProgress" Width="100" Height="3" Minimum="0" Maximum="1" Margin="10,0,0,0"
                                     Foreground="#2F3640" Background="#C9CDD2" BorderThickness="0"
                                     Visibility="Collapsed" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="BtnNotes" Content="Cambios" Style="{StaticResource BtnGhost}" Padding="9,3" Margin="0,0,6,0" Click="BtnNotes_Click" />
                        <Button x:Name="BtnApplyUpdate" Content="Actualizar" Style="{StaticResource Btn}" Padding="9,3"
                                Margin="0" Click="BtnApplyUpdate_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl x:Name="PageHost" Grid.Row="1" />
        </Grid>
    </Grid>
</Window>
