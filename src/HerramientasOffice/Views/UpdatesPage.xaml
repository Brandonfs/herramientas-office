<UserControl x:Class="HerramientasOffice.Views.UpdatesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Actualizaciones" FontSize="20" FontWeight="SemiBold"
                   Foreground="{StaticResource InkBrush}" Margin="28,22,28,8" />

        <Border Grid.Row="1" x:Name="AdminWarning" Visibility="Collapsed" Background="#F1EBDA" Padding="28,8">
            <TextBlock Foreground="#6B5313" Text="Sin permisos de administrador: solo lectura." />
        </Border>

        <!-- Acciones y filtros -->
        <Border Grid.Row="2" Padding="28,12,28,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnRefresh" Content="Actualizar" Style="{StaticResource BtnGhost}" Click="BtnRefresh_Click" />
                    <Border Width="1" Background="#D5D8DC" Margin="4,4,12,4" />
                    <Button x:Name="BtnUninstall" Content="Desinstalar" Style="{StaticResource BtnDanger}" Click="BtnUninstall_Click" IsEnabled="False" />
                    <Button x:Name="BtnBlock" Content="Bloquear" Style="{StaticResource Btn}" Click="BtnBlock_Click" IsEnabled="False" />
                    <Button x:Name="BtnEnable" Content="Habilitar" Style="{StaticResource Btn}" Click="BtnEnable_Click" IsEnabled="False" />
                    <Border Width="1" Background="#D5D8DC" Margin="4,4,12,4" />
                    <Button x:Name="BtnMark" Content="Marcar" ToolTip="Marcar o desmarcar como problemática"
                            Style="{StaticResource BtnGhost}" Click="BtnMark_Click" IsEnabled="False" />
                    <Button x:Name="BtnCatalog" Content="Catálogo" ToolTip="Ver en el catálogo de Microsoft"
                            Style="{StaticResource BtnGhost}" Click="BtnCatalog_Click" IsEnabled="False" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <ComboBox x:Name="ProductCombo" Width="150" Height="30" VerticalContentAlignment="Center"
                              Margin="0,0,10,0" SelectionChanged="Filters_Changed">
                        <ComboBoxItem Content="Excel y Word" IsSelected="True" />
                        <ComboBoxItem Content="Excel" />
                        <ComboBoxItem Content="Word" />
                        <ComboBoxItem Content="Todo Office" />
                    </ComboBox>
                    <ComboBox x:Name="StateCombo" Width="130" Height="30" VerticalContentAlignment="Center"
                              Margin="0,0,10,0" SelectionChanged="Filters_Changed">
                        <ComboBoxItem Content="Todos" IsSelected="True" />
                        <ComboBoxItem Content="Instaladas" />
                        <ComboBoxItem Content="Disponibles" />
                        <ComboBoxItem Content="Bloqueadas" />
                    </ComboBox>
                    <Grid Width="220">
                        <TextBox x:Name="SearchBox" Height="30" VerticalContentAlignment="Center" Padding="8,0"
                                 BorderBrush="#D5D8DC" TextChanged="SearchBox_TextChanged" />
                        <TextBlock x:Name="SearchPlaceholder" Text="Buscar" Foreground="#9AA0A8" IsHitTestVisible="False"
                                   VerticalAlignment="Center" Margin="10,0,0,0" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Lista -->
        <Border Grid.Row="3" Margin="28,0,28,10" Background="White" CornerRadius="8"
                BorderBrush="#E3E5E8" BorderThickness="1">
            <Grid>
                <DataGrid x:Name="UpdatesGrid"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                          SelectionMode="Extended" SelectionUnit="FullRow"
                          HeadersVisibility="Column" GridLinesVisibility="None"
                          RowHeight="42" Background="White" BorderThickness="0"
                          ColumnHeaderStyle="{StaticResource GridHeader}"
                          CellStyle="{StaticResource GridCell}"
                          RowStyle="{StaticResource GridRow}"
                          SelectionChanged="UpdatesGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="KB" SortMemberPath="KbNumber" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="●" Foreground="#B0832B" FontSize="9" VerticalAlignment="Center" Margin="0,0,7,0"
                                                   ToolTip="Marcada como problemática"
                                                   Visibility="{Binding IsProblem, Converter={StaticResource B2V}}" />
                                        <TextBlock Text="{Binding KbDisplay}" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Producto" Binding="{Binding Product}" Width="90"
                                            ElementStyle="{StaticResource CellText}" />
                        <DataGridTemplateColumn Header="Estado" SortMemberPath="StateText" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border x:Name="Pill" CornerRadius="4" Padding="8,2" HorizontalAlignment="Left" Background="#E8EAED">
                                        <TextBlock x:Name="PillText" Text="{Binding StateText}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="#3A424C" />
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding StateText}" Value="Disponible">
                                            <Setter TargetName="Pill" Property="Background" Value="#F1EAD6" />
                                            <Setter TargetName="PillText" Property="Foreground" Value="#7A5C14" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StateText}" Value="Bloqueada">
                                            <Setter TargetName="Pill" Property="Background" Value="#DDE8E1" />
                                            <Setter TargetName="PillText" Property="Foreground" Value="#2E5A44" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Publicada" Binding="{Binding PublishedDisplay}" SortMemberPath="PublishedDate" Width="100"
                                            ElementStyle="{StaticResource CellText}" />
                        <DataGridTextColumn Header="Instalada" Binding="{Binding InstalledDisplay}" SortMemberPath="InstalledDate" Width="100"
                                            ElementStyle="{StaticResource CellText}" />
                        <DataGridTextColumn Header="Reemplazo" Binding="{Binding SupersededByDisplay}" Width="170"
                                            ElementStyle="{StaticResource CellText}" />
                        <DataGridTextColumn Header="Descripción" Binding="{Binding Title}" Width="*"
                                            ElementStyle="{StaticResource CellTitle}" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="EmptyText" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#9AA0A8" FontSize="14" Text="Sin resultados" />
            </Grid>
        </Border>

        <!-- Resumen y progreso -->
        <Grid Grid.Row="4" Margin="28,0,28,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SummaryText" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <ProgressBar x:Name="BusyBar" Width="120" Height="4" IsIndeterminate="True" Visibility="Collapsed"
                             Foreground="#2F3640" Background="#E3E5E8" BorderThickness="0" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Registro -->
        <Border x:Name="LogPanel" Grid.Row="5" Visibility="Collapsed" Margin="28,0,28,18" Background="#22262B" CornerRadius="6" Padding="2">
            <TextBox x:Name="LogBox" Height="64" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                     Foreground="#C5CAD1" FontFamily="Consolas" FontSize="12" Padding="10,6"
                     VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" />
        </Border>
    </Grid>
</UserControl>
