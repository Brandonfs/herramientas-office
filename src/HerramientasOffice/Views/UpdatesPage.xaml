<UserControl x:Class="HerramientasOffice.Views.UpdatesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" x:Name="AdminWarning" Visibility="Collapsed" Background="#F1EBDA" Padding="14,5">
            <TextBlock Foreground="#6B5313" FontSize="12" Text="Sin permisos de administrador: solo lectura." />
        </Border>

        <!-- Acciones y filtros (se acomodan en varias filas si la ventana es angosta) -->
        <WrapPanel Grid.Row="1" Margin="14,10,14,2">
            <Button x:Name="BtnRefresh" Content="Actualizar" Style="{StaticResource BtnGhost}" Click="BtnRefresh_Click" />
            <Button x:Name="BtnUninstall" Content="Desinstalar" Style="{StaticResource BtnDanger}" Click="BtnUninstall_Click" IsEnabled="False" />
            <Button x:Name="BtnBlock" Content="Bloquear" Style="{StaticResource Btn}" Click="BtnBlock_Click" IsEnabled="False" />
            <Button x:Name="BtnEnable" Content="Habilitar" Style="{StaticResource Btn}" Click="BtnEnable_Click" IsEnabled="False" />
            <Button x:Name="BtnMark" Content="Marcar" ToolTip="Marcar o desmarcar como problemática"
                    Style="{StaticResource BtnGhost}" Click="BtnMark_Click" IsEnabled="False" />
            <Button x:Name="BtnCatalog" Content="Catálogo" ToolTip="Ver en el catálogo de Microsoft"
                    Style="{StaticResource BtnGhost}" Click="BtnCatalog_Click" IsEnabled="False" />
            <ComboBox x:Name="ProductCombo" Width="95" Height="28" FontSize="12" VerticalContentAlignment="Center"
                      Margin="8,0,6,6" SelectionChanged="Filters_Changed">
                <ComboBoxItem Content="Excel" IsSelected="True" />
                <ComboBoxItem Content="Word" />
                <ComboBoxItem Content="Todo Office" />
            </ComboBox>
            <ComboBox x:Name="StateCombo" Width="95" Height="28" FontSize="12" VerticalContentAlignment="Center"
                      Margin="0,0,6,6" SelectionChanged="Filters_Changed">
                <ComboBoxItem Content="Todos" IsSelected="True" />
                <ComboBoxItem Content="Instaladas" />
                <ComboBoxItem Content="Disponibles" />
                <ComboBoxItem Content="Bloqueadas" />
            </ComboBox>
            <Grid Width="120" Margin="0,0,0,6">
                <TextBox x:Name="SearchBox" Height="28" FontSize="12" VerticalContentAlignment="Center" Padding="6,0"
                         BorderBrush="#D5D8DC" TextChanged="SearchBox_TextChanged" />
                <TextBlock x:Name="SearchPlaceholder" Text="Buscar" FontSize="12" Foreground="#9AA0A8" IsHitTestVisible="False"
                           VerticalAlignment="Center" Margin="8,0,0,0" />
            </Grid>
        </WrapPanel>

        <!-- Lista -->
        <Border Grid.Row="2" Margin="14,4,14,6" Background="White" CornerRadius="6"
                BorderBrush="#E3E5E8" BorderThickness="1">
            <Grid>
                <DataGrid x:Name="UpdatesGrid" FontSize="12"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                          SelectionMode="Extended" SelectionUnit="FullRow"
                          HeadersVisibility="Column" GridLinesVisibility="None"
                          RowHeight="32" Background="White" BorderThickness="0"
                          ColumnHeaderStyle="{StaticResource GridHeader}"
                          CellStyle="{StaticResource GridCell}"
                          RowStyle="{StaticResource GridRow}"
                          SelectionChanged="UpdatesGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="KB" SortMemberPath="KbNumber" Width="115">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="●" Foreground="#B0832B" FontSize="8" VerticalAlignment="Center" Margin="0,0,6,0"
                                                   ToolTip="Marcada como problemática"
                                                   Visibility="{Binding IsProblem, Converter={StaticResource B2V}}" />
                                        <TextBlock Text="{Binding KbDisplay}" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Estado" SortMemberPath="StateText" Width="95">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border x:Name="Pill" CornerRadius="4" Padding="6,1" HorizontalAlignment="Left" Background="#E8EAED">
                                        <TextBlock x:Name="PillText" Text="{Binding StateText}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="#3A424C" />
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding StateText}" Value="Disponible">
                                            <Setter TargetName="Pill" Property="Background" Value="#F1EAD6" />
                                            <Setter TargetName="PillText" Property="Foreground" Value="#7A5C14" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StateText}" Value="Bloqueada">
                                            <Setter TargetName="Pill" Property="Background" Value="#DDE8E1" />
                                            <Setter TargetName="PillText" Property="Foreground" Value="#2E5A44" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Publicada" Binding="{Binding PublishedDisplay}" SortMemberPath="PublishedDate" Width="82"
                                            ElementStyle="{StaticResource CellText}" />
                        <DataGridTextColumn Header="Instalada" Binding="{Binding InstalledDisplay}" SortMemberPath="InstalledDate" Width="82"
                                            ElementStyle="{StaticResource CellText}" />
                        <DataGridTextColumn Header="Reemplazo" Binding="{Binding SupersededByDisplay}" Width="100"
                                            ElementStyle="{StaticResource CellText}" />
                        <DataGridTextColumn Header="Descripción" Binding="{Binding Title}" Width="*"
                                            ElementStyle="{StaticResource CellTitle}" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="EmptyText" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#9AA0A8" Text="Sin resultados" />
            </Grid>
        </Border>

        <!-- Resumen y progreso -->
        <Grid Grid.Row="3" Margin="14,0,14,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SummaryText" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock x:Name="StatusText" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ProgressBar x:Name="BusyBar" Width="90" Height="3" IsIndeterminate="True" Visibility="Collapsed"
                             Foreground="#2F3640" Background="#E3E5E8" BorderThickness="0" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Registro (solo aparece cuando hay actividad) -->
        <Border x:Name="LogPanel" Grid.Row="4" Visibility="Collapsed" Margin="14,0,14,10" Background="#22262B" CornerRadius="5" Padding="1">
            <TextBox x:Name="LogBox" Height="42" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                     Foreground="#C5CAD1" FontFamily="Consolas" FontSize="11" Padding="8,4"
                     VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" />
        </Border>
    </Grid>
</UserControl>
